---
import ProjectLayout from '../../layouts/ProjectLayout.astro';
---

<ProjectLayout
  title="VZLA SXXI"
  year="2017-2018"
  materials={["Ink", "Laser Prints", "Screen Tones", "Acrylic Markers"]}
>
  <p>
    Venezuela Siglo XXI is a series of collages created in 2017-2018 inspired by the political, economic and social situation of Venezuela.
  </p>

  <Fragment slot="images">
    <div class="project-img-2col">
      <img src="/img/projects/VZLA-SXXI/vzla-sxxi-1.png" alt="VZLA-SXXI" />
    </div>
    <div class="project-img-2col">
      <img src="/img/projects/VZLA-SXXI/vzla-sxxi-2.png" alt="VZLA-SXXI" />
    </div>
    <div class="project-img-2col">
      <img src="/img/projects/VZLA-SXXI/vzla-sxxi-3.png" alt="VZLA-SXXI" />
    </div>
    <div class="project-img-2col">
      <img src="/img/projects/VZLA-SXXI/vzla-sxxi-4.png" alt="VZLA-SXXI" />
    </div>

    <p class="project-images-label">Typographic exploration with ink and screen tones.</p>

    <div class="project-img-2col">
      <img src="/img/projects/VZLA-SXXI/vzla-sxxi-5.png" alt="VZLA-SXXI" />
    </div>
    <div class="project-img-2col">
      <img src="/img/projects/VZLA-SXXI/vzla-sxxi-6.png" alt="VZLA-SXXI" />
    </div>
  </Fragment>
</ProjectLayout>
